{
  "name": "@servis-track/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:prod": "prisma migrate deploy && tsx src/index.ts",
    "build": "prisma generate",
    "typecheck": "tsc --noEmit",
    "prisma": "prisma",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "apikey": "tsx prisma/api-key.ts",
    "studio": "prisma studio",
    "test": "vitest run"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@servis-track/shared": "workspace:*",
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "jose": "6.2.4",
    "multer": "2.2.0",
    "nodemailer": "9.0.3",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prisma": "7.8.0",
    "tsx": "4.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "22.20.1",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.1",
    "pino-pretty": "13.1.3",
    "supertest": "7.2.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
