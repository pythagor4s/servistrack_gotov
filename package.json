{
  "name": "servis-track",
  "version": "0.0.0",
  "private": true,
  "description": "ServisTrack - servisni zahtevki, baza znanja in plan vzdrzevanja.",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @servis-track/api dev\" \"pnpm --filter @servis-track/web dev\"",
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --if-present run test",
    "lint": "pnpm -r --if-present run lint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "concurrently": "10.0.3",
    "typescript": "5.9.3"
  }
}
